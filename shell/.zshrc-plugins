# Sourced by the base image shell before oh-my-zsh reads the plugins variable, so this is
# the only place where the plugin list has an effect. The base lists vscode, git, colorize,
# docker and docker-compose. This file should NOT interact with stdout nor stdin.
# No rustup plugin exists in oh-my-zsh: its completions come from ~/.zfunc/_rustup,
# generated in the Dockerfile.
plugins=($plugins rust kubectl helm)
